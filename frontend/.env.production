# Variabili usate dalla build web di produzione: "npm run build" (vite build, mode production).
# In produzione il proxy di Vite non esiste: il backend si chiama per URL assoluto.
# Si puo' sovrascrivere dall'ambiente, es. VITE_API_URL=https://api.example.com/api npm run build
VITE_API_URL=http://localhost:3001/api
