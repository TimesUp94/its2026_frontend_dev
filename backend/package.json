{
  "name": "minicommerce-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "db:push": "drizzle-kit push --force",
    "db:seed": "node src/seed.ts",
    "db:reset": "rm -f minicommerce.db minicommerce.db-shm minicommerce.db-wal && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
