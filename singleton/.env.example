# Percorso del file SQLite. Di default il database vive dentro singleton/.
# Puntandolo al file del backend Express le due versioni condividono i dati:
# DATABASE_URL=../backend/minicommerce.db
DATABASE_URL=minicommerce.db

# Segreto con cui viene firmato il cookie di sessione.
# Obbligatorio in produzione: senza, viene usato un valore di sviluppo.
JWT_SECRET=cambia-questo-valore
